# Caddyfile — serve the standalone wasm-visor on a subdomain.
#
# This is a PLAIN static file server. It never talks to skywire-cli or a visor
# RPC — it just serves the self-contained index.html generated by
# `skywire cli hv gen` (see the .path/.service units in this directory, which
# regenerate it on every skywire update).
#
# Replace wasm.example.net with your subdomain. Caddy auto-provisions HTTPS.
#
# SAFETY: the served file is KEYLESS — each visitor's browser mints + persists
# its own ephemeral key (localStorage). The page NEVER asks anyone to type a
# secret key, so serving it from a domain is safe (the "key-entry spoof" risk
# only applies to key-BEARING generated files — never serve those from a domain).

wasm.example.net {
	root * /var/www/wasm-visor
	encode zstd gzip
	# Single-page app: the only artifact is index.html (everything inlined).
	try_files {path} /index.html
	file_server

	header {
		# The wasm-visor needs SharedArrayBuffer-free WASM (it doesn't use threads),
		# so no COOP/COEP is required. Keep it simple; add caching for the big file.
		Cache-Control "public, max-age=300"
	}
}
