<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon: the Skycoin cloud (brand-blue bitmap) scaled into the center
     safe circle of the 108dp splash-icon canvas (Android 12+ masks it).
     53x40dp keeps the logo's 4:3 box inside the 66dp circle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="53dp"
        android:height="40dp"
        android:gravity="center"
        android:drawable="@drawable/skywire_logo" />
</layer-list>
