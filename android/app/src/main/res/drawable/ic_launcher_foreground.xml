<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the Skycoin cloud tinted white over the
     brand-blue background layer. 44x33dp keeps the logo's 4:3 box fully
     inside the 66dp safe circle (half-diagonal 27.5dp), so no launcher
     mask or parallax scale ever crowds the cloud against the edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="44dp"
        android:height="33dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/skywire_logo"
            android:tint="@android:color/white" />
    </item>
</layer-list>
