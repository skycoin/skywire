<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The visor talks to dmsg/transports; the app talks to its local API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SkywireCoreService runs the visor as a foreground service. specialUse
         (not dataSync) because Android 15 caps dataSync services at ~6 h and
         the visor is an always-on network node while connected. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Runtime-granted on API 33+; the FGS notification is invisible without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice messages (and the video messages the chat UI already renders a
         player for) go through getUserMedia inside the embedded SkyChat page;
         the WebChromeClient maps its request onto these. Both are optional
         features so a device without a camera still installs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not optional and not obvious: WebView's audio manager refuses to open
         a capture device without it, even with RECORD_AUDIO granted, and
         getUserMedia fails with a bare "NotReadableError: Could not start
         audio source" while logcat says "Requires MODIFY_AUDIO_SETTINGS and
         RECORD_AUDIO". Install-time permission — no runtime prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- allowBackup=false: the visor config (SK) and wallet seed must never
         land in a cloud backup. -->
    <application
        android:name=".SkywireApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Skywire.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Skywire.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- skychat:// addresses and skychat:invite: links — a scanned QR,
                 a link in another chat, a contact card. The app opens the Chat
                 tab's Add-by-address dialog on it and resolves it; acting on
                 the result stays a tap. BROWSABLE is what makes a link in a
                 browser or another app reach us at all.

                 Only this scheme is claimed. skycoin:// belongs to the Skycoin
                 wallet app, which is already installed on the same phones. -->
            <intent-filter android:label="@string/app_skychat">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="skychat" />
            </intent-filter>
        </activity>

        <!-- The visor core: execs libskywire-mobile.so as a child process and
             keeps it alive while the user is connected. -->
        <service
            android:name=".core.SkywireCoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the Skywire visor — the peer-to-peer networking core the user explicitly connects to and disconnects from; it must stay up while apps use the mesh." />
        </service>

        <!-- SkyVpnService declaration lands with the VPN feature. -->
    </application>

</manifest>
