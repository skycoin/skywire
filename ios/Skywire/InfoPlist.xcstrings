  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyChat uses the camera to record video messages and scan QR codes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyChat usa la cámara para grabar mensajes de vídeo y escanear códigos QR."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyChat 使用相机录制视频消息和扫描二维码。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire uses Face ID to unlock the app when the app lock is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire usa Face ID para desbloquear la app cuando el bloqueo de la app está activado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启应用锁后，Skywire 会使用面容 ID 解锁应用。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyChat uses the microphone to record voice and video messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyChat usa el micrófono para grabar mensajes de voz y de vídeo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyChat 使用麦克风录制语音和视频消息。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire saves the pictures and videos you choose to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire guarda en tu fototeca las imágenes y los vídeos que elijas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire 会把你选择的图片和视频保存到照片图库。"
          }
        }
      }
    }
