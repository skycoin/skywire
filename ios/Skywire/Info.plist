<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE, the
  INFOPLIST_KEY_* build settings); only what those cannot express is here.
  The one ATS exception: plain HTTP to local addresses, for the core's local
  API on 127.0.0.1:8000 and the apps' UIs beside it. Nothing else.
  SkywireKeychainGroup: the Keychain access group SecretStore writes in, so
  the packet-tunnel extension (Lane D) reads the same items; from the
  xcconfig, with the team prefix once signing exists.
  SkywireWalletKeychainGroup: the wallet's own group (WalletSeedStore), which
  the extension never gets: recovery phrases stay with the app.
  NSFaceIDUsageDescription: the app lock (Settings), and the check before a
  wallet send or a recovery phrase is shown. NSMicrophoneUsageDescription
  and NSCameraUsageDescription: the chat page's voice and video messages and
  its QR scanner (getUserMedia; without them the app is killed at the first
  capture), the wallet's address scanner, and the microphone a call lends
  the visor (M6).
  UIBackgroundModes audio: a connected call keeps its audio when the app
  leaves the foreground (M6), nothing else; the core's own receiving while
  suspended is the packet-tunnel extension's (Lane D).
  NSPhotoLibraryAddUsageDescription: the share sheet's "Save Image" and
  "Save Video" for a chat download. All translated in InfoPlist.xcstrings.
  CFBundleURLTypes: skychat: links (the xcconfig's SKYWIRE_URL_SCHEME), which
  the chat page shows in its Add-by-address dialog (ChatRouter). Only skychat:
  is claimed; skycoin: belongs to the Skycoin wallet.
  UIAppFonts and UILaunchScreen: Android's two typefaces and its splash
  (the logo on white, #0A101C at night), M6.5.
-->
<plist version="1.0">
<dict>
	<key>SkywireKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(SKYWIRE_KEYCHAIN_GROUP)</string>
	<key>SkywireWalletKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(SKYWIRE_WALLET_KEYCHAIN_GROUP)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Skywire uses Face ID to unlock the app when the app lock is on, and to confirm wallet sends and the showing of a recovery phrase.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SkyChat uses the microphone to record voice and video messages.</string>
	<key>NSCameraUsageDescription</key>
	<string>Skywire uses the camera to record video messages and scan QR codes in SkyChat and the wallet.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Skywire saves the pictures and videos you choose to your photo library.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).skychat</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(SKYWIRE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>quicksand_variable.ttf</string>
		<string>nunito_variable.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>launch-logo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
