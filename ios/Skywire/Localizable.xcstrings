          }
        }
      }
    },
    "dex_trade_summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sell %1$@ %2$@ for %3$@ %4$@. After creating this order you have 15 minutes to deposit the %2$@ (amount + a small commission) to the market escrow; the buyer’s payment goes straight to your wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vender %1$@ %2$@ por %3$@ %4$@. Tras crear esta orden tienes 15 minutos para depositar los %2$@ (cantidad + una pequeña comisión) en la custodia del mercado; el pago del comprador va directo a tu billetera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendre %1$@ %2$@ contre %3$@ %4$@. Après avoir créé cet ordre, vous avez 15 minutes pour déposer les %2$@ (montant + une petite commission) au séquestre du marché ; le paiement de l’acheteur arrive directement dans votre portefeuille."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 %3$@ %4$@ 出售 %1$@ %2$@。创建此订单后，你有 15 分钟时间将 %2$@（数量 + 少量手续费）存入市场托管；买家的付款将直接进入你的钱包。"
          }
        }
      }
    },
