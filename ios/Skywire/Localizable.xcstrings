    "fleet_rename_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A name for %1$@, so you know which machine it is. Kept on this phone only — the visor is never written to. Clear the field to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre para %1$@, para que sepas qué máquina es. Se guarda solo en este teléfono: nunca se escribe nada en el nodo. Vacía el campo para quitarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给 %1$@ 起个名字，方便你分辨是哪台机器。名称只保存在本手机，不会写入该节点。清空输入框即可删除。"
          }
        }
      }
    },
