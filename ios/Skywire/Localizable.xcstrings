    "hops_custom_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every route the visor builds must use at least this many hops. Each hop past the first buys more separation between who is asking and what is asked — and costs latency, plus one more machine that has to stay up. The route finder searches at most 10 hops deep, so higher values can never be built."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ruta que construya el nodo tendrá al menos este número de saltos. Cada salto a partir del primero compra más separación entre quién pregunta y qué se pregunta, y cuesta latencia, además de una máquina más que tiene que seguir en pie. El buscador de rutas explora como mucho 10 saltos, así que valores mayores nunca podrán construirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque route que construit le visor doit utiliser au moins ce nombre de sauts. Chaque saut au-delà du premier achète plus de séparation entre qui demande et ce qui est demandé — et coûte de la latence, plus une machine de plus qui doit rester debout. Le chercheur de routes explore au plus 10 sauts de profondeur, donc les valeurs plus hautes ne pourront jamais être construites."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节点建立的每条路由，至少都要经过这么多跳。第一跳之后每增加一跳，请求者与请求内容之间的隔离就更强一分，代价是更高的延迟，以及多一台必须保持在线的机器。路由查找最深只搜索 10 跳，因此更大的值永远无法建立路由。"
          }
        }
      }
    },
