        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not through SkyVPN"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pasa por SkyVPN"
          }
