    "wallet_coin_remove_blocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove its wallets first. Deleting a wallet erases its recovery phrase from this phone, so it is a separate decision from tidying this list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita antes sus billeteras. Borrar una billetera elimina su frase de recuperación de este teléfono, así que es una decisión aparte de ordenar esta lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirez d’abord ses portefeuilles. Supprimer un portefeuille efface sa phrase de récupération de ce téléphone, c’est donc une décision distincte de ranger cette liste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先移除它的钱包。删除钱包会把助记词从这部手机上抹除，所以那是与整理列表无关的另一个决定。"
          }
        }
      }
    },
