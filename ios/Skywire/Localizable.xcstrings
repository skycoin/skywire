    "wallet_screenshot_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It shows your recovery phrase and is now in Photos, where it can sync to your other devices. Delete it: anyone who sees those words can spend your coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tu frase de recuperación y ahora está en Fotos, desde donde puede sincronizarse con tus otros dispositivos. Bórrala: quien vea esas palabras puede gastar tus monedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle montre votre phrase de récupération et se trouve maintenant dans Photos, d’où elle peut se synchroniser avec vos autres appareils. Supprimez-la : quiconque voit ces mots peut dépenser vos coins."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截屏中有你的助记词，现在已存入“照片”，并可能同步到你的其他设备。请删除它：任何看到这些单词的人都能花掉你的币。"
          }
        }
      }
