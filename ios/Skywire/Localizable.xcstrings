    "transport_dmsg_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relayed through a DMSG server. Works behind any carrier NAT — the connection a phone can always make."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retransmitido a través de un servidor DMSG. Funciona detrás de cualquier NAT de operador: la conexión que un teléfono siempre puede hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relayé via un serveur DMSG. Fonctionne derrière tout NAT d’opérateur — la connexion qu’un téléphone peut toujours établir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 DMSG 服务器中转。在任何运营商 NAT 后面都能用——手机总能建立的连接。"
          }
        }
      }
    },
    "transport_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tried first when building the route to a server. The others stay as fallbacks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se prueba primero al construir la ruta hacia un servidor. Los demás quedan como alternativa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayé en premier lors de la construction de la route vers un serveur. Les autres restent en repli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立到服务器的路由时优先尝试这一类型，其余类型仍作为备用。"
          }
        }
      }
    },
    "transport_recommended" : {
      "extractionState" : "manual",
