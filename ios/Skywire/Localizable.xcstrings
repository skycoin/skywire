    "fleet_restart_confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart %1$@? It closes everything it is running, re-reads its config and starts again — offline for a few seconds, and anything routed through it drops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Reiniciar %1$@? Cierra todo lo que está ejecutando, vuelve a leer su configuración y arranca de nuevo: unos segundos sin conexión, y todo lo enrutado a través de él se cae."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarrer %1$@ ? Cela ferme tout ce qu’il exécute, relit sa configuration et repart — hors ligne quelques secondes, et tout ce qui passait par lui est coupé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要重启 %1$@ 吗？它会关闭正在运行的一切，重新读取配置后再启动——离线几秒，经由它路由的连接都会断开。"
          }
        }
      }
    },
    "fleet_restart_sent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart sent to %1$@. It goes offline and comes back on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicio enviado a %1$@. Se desconectará y volverá por su cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarrage envoyé à %1$@. Il passe hors ligne et revient de lui-même."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已向 %1$@ 发送重启指令。它会先离线，然后自行恢复。"
          }
        }
      }
    },
