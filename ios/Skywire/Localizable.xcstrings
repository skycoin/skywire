    "transport_sudph_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct UDP with hole punching. Needs a NAT that allows it — many carriers do not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP directo con perforación de NAT. Necesita un NAT que lo permita, y muchos operadores no lo hacen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP direct avec trou de NAT. Exige un NAT qui l’autorise — beaucoup d’opérateurs non."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带打洞的 UDP 直连。需要 NAT 允许打洞——很多运营商并不允许。"
          }
        }
      }
    },
