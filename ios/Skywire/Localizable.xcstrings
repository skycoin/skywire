    "diag_core_host_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug builds only. In the app, the core stops when iOS suspends Skywire; in the packet tunnel, iOS keeps it running. Applies the next time Skywire opens. The Simulator cannot run the packet tunnel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en compilaciones de depuración. En la app, el núcleo se detiene cuando iOS suspende Skywire; en el túnel de paquetes, iOS lo mantiene en marcha. Se aplica la próxima vez que abras Skywire. El simulador no puede ejecutar el túnel de paquetes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versions de débogage uniquement. Dans l’app, le cœur s’arrête quand iOS suspend Skywire ; dans le tunnel de paquets, iOS le maintient en marche. S’applique à la prochaine ouverture de Skywire. Le simulateur ne peut pas faire tourner le tunnel de paquets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限调试版本。在应用内运行时，iOS 挂起 Skywire 后核心会停止；在数据包隧道中运行时，iOS 会让它保持运行。下次打开 Skywire 时生效。模拟器无法运行数据包隧道。"
          }
        }
      }
    },
    "diag_core_host_tunnel" : {
