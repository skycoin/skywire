      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new key is generated on this phone. Nobody has it yet, so nobody can reach you at it until you share it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva clave se genera en este teléfono. Todavía no la tiene nadie, así que nadie podrá alcanzarte en ella hasta que la compartas de nuevo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新密钥在这部手机上生成。目前还没有人拥有它，在你再次分享之前，没有人能通过它找到你。"
          }
        }
      }
    },
    "settings_new_final_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current key is destroyed, not archived. If you have not exported the config, this identity is gone for good — along with everything addressed to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave actual se destruye, no se archiva. Si no has exportado la configuración, esta identidad se pierde para siempre, junto con todo lo que estuviera dirigido a ella."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前密钥会被销毁，而不是存档。如果你没有导出配置，这个身份就永远消失了——发往它的一切也一并消失。"
          }
        }
      }
    },
