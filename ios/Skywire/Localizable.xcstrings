    "wallet_reveal_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who reads these words can move every coin in %1$@, from any device, without your phone. Only reveal them somewhere no one can see your screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que lea estas palabras puede mover todas las monedas de %1$@, desde cualquier dispositivo y sin tu teléfono. Muéstralas solo donde nadie pueda ver tu pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque lit ces mots peut déplacer chaque pièce de %1$@, depuis n’importe quel appareil, sans votre téléphone. Ne les révélez que là où personne ne peut voir votre écran."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人读到这些助记词，都能在任意设备上转走 %1$@ 中的全部币，不需要你的手机。只在没有人能看到你屏幕的地方查看它们。"
          }
        }
      }
