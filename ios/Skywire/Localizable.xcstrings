    "wallet_seed_secure_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Covered while the screen is recorded or mirrored, and in the app switcher. iOS does not let an app block screenshots. There is no copy button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tapa mientras la pantalla se graba o se duplica, y en el selector de apps. iOS no permite que una app bloquee las capturas de pantalla. No hay botón de copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquée pendant que l’écran est enregistré ou recopié, et dans le sélecteur d’apps. iOS ne permet pas à une app de bloquer les captures d’écran. Il n’y a pas de bouton Copier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕被录制或镜像时，以及在应用切换器中，这些单词会被遮住。iOS 不允许应用禁止截屏。本页面没有复制按钮。"
          }
        }
      }
    },
