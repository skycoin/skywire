    "wallet_node_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balances, transactions and broadcasts for %1$@ are read from and sent to this node. Change it if the one shipped with the app cannot be reached from where you are, or if you run your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los saldos, las transacciones y los envíos de %1$@ se leen de este nodo y se mandan a él. Cámbialo si el que viene con la app no se puede alcanzar desde donde estás, o si tienes uno propio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldes, transactions et diffusions pour %1$@ sont lus depuis et envoyés à ce nœud. Changez-le si celui livré avec l’application est injoignable d’où vous êtes, ou si vous faites tourner le vôtre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的余额、交易记录和广播都通过该节点收发。如果应用自带的节点在你所在的网络无法访问，或你有自建节点，可在此更改。"
          }
        }
      }
    },
    "wallet_node_body_indexer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balances, fees and broadcasts for %1$@ go to the node, and its transaction history is read from the indexer. Change them if the ones shipped with the app cannot be reached from where you are, or if you run your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los saldos, las comisiones y los envíos de %1$@ van al nodo, y su historial de transacciones se lee del indexador. Cámbialos si los que vienen con la app no se pueden alcanzar desde donde estás, o si tienes los tuyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldes, frais et diffusions pour %1$@ vont au nœud, et son historique de transactions est lu depuis l’indexeur. Changez-les si ceux livrés avec l’application sont injoignables d’où vous êtes, ou si vous faites tourner les vôtres."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的余额、手续费和广播都通过节点收发，交易记录则从索引服务读取。如果应用自带的地址在你所在的网络无法访问，或你有自建服务，可在此更改。"
          }
        }
      }
    },
    "wallet_node_cleartext" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not encrypted. Everyone between this phone and that address sees your whole address list and its balances. Your coins stay safe — keys never leave the device — but the addresses are linked to each other for anyone watching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cifrar. Todo el mundo entre este teléfono y esa dirección ve tu lista de direcciones entera y sus saldos. Tus monedas siguen a salvo —las claves nunca salen del dispositivo—, pero las direcciones quedan ligadas entre sí para cualquiera que esté mirando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non chiffré. Quiconque se trouve entre ce téléphone et cette adresse voit toute votre liste d’adresses et ses soldes. Vos pièces restent en sécurité — les clés ne quittent jamais l’appareil — mais les adresses sont liées entre elles pour tout observateur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未加密。本机与该地址之间的任何人都能看到你的全部地址列表及余额。你的币是安全的——密钥从不离开本机——但在旁观者眼中，这些地址会被关联到一起。"
          }
        }
      }
