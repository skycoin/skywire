            "state" : "translated",
            "value" : "It goes from your coin list. Nothing on the chain changes and no keys are touched — you can add it again with the same details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparece de tu lista de monedas. No cambia nada en la cadena ni se toca ninguna clave: puedes volver a añadirla con los mismos datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle disparaît de votre liste de pièces. Rien ne change sur la chaîne et aucune clé n’est touchée — vous pouvez la rajouter avec les mêmes détails."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
