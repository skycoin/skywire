    "call_suspended_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calls ring only while Skywire is running. Nothing rings a phone the app has been suspended on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas suenan solo mientras Skywire está en ejecución. Un teléfono con la app suspendida no suena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels ne sonnent que pendant que Skywire tourne. Rien ne sonne sur un téléphone où l’app a été suspendue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在 Skywire 运行时来电才会响铃。应用被暂停的手机不会收到任何响铃。"
          }
        }
      }
    },
