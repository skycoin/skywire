      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct UDP with hole punching. Needs a NAT that allows it — many carriers do not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP directo con perforación de NAT. Necesita un NAT que lo permita, y muchos operadores no lo hacen."
