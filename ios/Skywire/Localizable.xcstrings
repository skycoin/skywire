    "chat_profile_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who has your public key can read this. It is not verified and not private — treat it as a label, not an identity. Leave it blank to publish nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que tenga tu clave pública puede leer esto. No está verificado ni es privado: trátalo como una etiqueta, no como una identidad. Déjalo en blanco para no publicar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque a votre clé publique peut lire ceci. Ce n’est ni vérifié ni privé — considérez-le comme une étiquette, pas comme une identité. Laissez vide pour ne rien publier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何拥有你公钥的人都能看到这些信息。它既未经验证，也不私密——请把它当作标签，而不是身份。留空则不公开任何内容。"
          }
        }
      }
    },
