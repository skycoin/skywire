    "socks_proxy_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point a proxy-aware app or browser at this address while SkySOCKS is connected. Whole-phone routing arrives with SkyVPN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta a esta dirección desde una app o un navegador que admita proxy mientras SkySOCKS esté conectado. El enrutamiento de todo el teléfono llega con SkyVPN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez une application ou un navigateur conscient des proxys vers cette adresse pendant que SkySOCKS est connecté. Le routage de tout le téléphone arrivera avec SkyVPN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
