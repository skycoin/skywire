        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail goes out now, over dmsg for a .dmsg address. A recipient whose visor is offline does not get it, and nothing retries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
