    "fleet_last_seen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last answered %1$@ ago — everything above is from then"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respondió por última vez hace %1$@: todo lo de arriba es de entonces"
          }
        },
        "zh-Hans" : {
