          }
        }
      }
    },
    "wallet_derivation_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deterministic is the classic Skycoin wallet. BIP44 keeps change on separate addresses. The same phrase gives different addresses in each, so restore it as the type it was made as."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determinista es la billetera clásica de Skycoin. BIP44 guarda el cambio en direcciones aparte. La misma frase da direcciones distintas en cada una, así que restáurala con el tipo con el que se creó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déterministe est le portefeuille Skycoin classique. BIP44 garde la monnaie sur des adresses à part. La même phrase donne des adresses différentes dans chacun, restaurez-la donc avec le type avec lequel elle a été créée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定性是经典的 Skycoin 钱包。BIP44 把找零放在单独的地址上。同一组助记词在两种类型下生成的地址不同，恢复时请选择创建时的类型。"
          }
        }
      }
    },
    "wallet_derivation_note_btc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native SegWit addresses start with bc1q and cost less to spend. Legacy addresses start with 1, for wallets and services that only know those. The same phrase gives different addresses in each, so restore it as the type it was made as."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las direcciones SegWit nativas empiezan por bc1q y cuesta menos gastar desde ellas. Las heredadas empiezan por 1, para billeteras y servicios que solo conocen esas. La misma frase da direcciones distintas en cada una, así que restáurala con el tipo con el que se creó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les adresses SegWit natives commencent par bc1q et coûtent moins cher à dépenser. Les adresses de l’ancien format commencent par 1, pour les portefeuilles et services qui ne connaissent qu’elles. La même phrase donne des adresses différentes dans chacun, restaurez-la donc avec le type avec lequel elle a été créée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生隔离见证地址以 bc1q 开头，花费时手续费更低。传统地址以 1 开头，适用于只支持这类地址的钱包和服务。同一组助记词在两种类型下生成的地址不同，恢复时请选择创建时的类型。"
          }
        }
      }
    },
