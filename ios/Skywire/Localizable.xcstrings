    "dex_history_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completed, cancelled and expired trades are kept on this device so History can show them after the market forgets them. Clearing removes that local copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las operaciones completadas, canceladas y caducadas se guardan en este dispositivo para que Historial pueda mostrarlas cuando el mercado ya las haya olvidado. Borrar elimina esa copia local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les échanges terminés, annulés et expirés sont conservés sur cet appareil pour que l’Historique puisse les afficher une fois que le marché les a oubliés. Effacer supprime cette copie locale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成、已取消和已过期的交易会保存在此设备上，这样即使市场已经删除，“历史”仍能显示它们。清除会删除这份本地副本。"
          }
        }
      }
    },
    "dex_history_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History is saved on this device — the market keeps finished orders only temporarily, so this list stays even after they’re removed there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial se guarda en este dispositivo. El mercado solo guarda los pedidos terminados por un tiempo, así que esta lista sigue aquí aunque allí se borren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique est enregistré sur cet appareil. Le marché ne garde les commandes terminées que temporairement, donc cette liste reste même après leur suppression là-bas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史保存在此设备本地。市场只会暂时保留已完成的订单，所以即使市场那边已删除，这里的列表仍会保留。"
          }
        }
      }
    },
