    "dex_trade_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set what you sell and what you want for it. Payment can be an external coin (BTC/LTC) or another fibercoin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
