    },
    "wallet_exposed_banner" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some addresses in this wallet still hold coins after having sent coins. Their public keys are on the blockchain, so a future quantum computer could steal those coins. Send them to a new address of this wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas direcciones de esta billetera aún tienen monedas después de haber enviado monedas. Sus claves públicas están en la cadena de bloques, así que un futuro ordenador cuántico podría robar esas monedas. Envíalas a una dirección nueva de esta billetera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines adresses de ce portefeuille détiennent encore des pièces après en avoir envoyé. Leurs clés publiques sont sur la blockchain, donc un futur ordinateur quantique pourrait voler ces pièces. Envoyez-les vers une nouvelle adresse de ce portefeuille."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个钱包里有些地址发送过币，但仍持有币。它们的公钥已在区块链上公开，未来的量子计算机可能会偷走这些币。请把它们转到本钱包的新地址。"
          }
        }
      }
    },
