    "core_seal_readback_failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sealed config could not be read back, so the unencrypted one is left in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo volver a leer la configuración sellada, así que se deja en su sitio la que no está cifrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration scellée n’a pas pu être relue, donc celle qui n’est pas chiffrée reste en place."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已加密的配置无法读回，因此保留了未加密的配置。"
          }
        }
      }
    },
    "core_sealed_key_gone_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sealed config cannot be opened: the key it was sealed under is no longer in this iPhone’s Keychain (the iPhone was erased, or Skywire’s data came back from a backup). The identity in it is unrecoverable; a new one can be generated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede abrir la configuración sellada: la clave con la que se selló ya no está en el llavero de este iPhone (el iPhone se borró, o los datos de Skywire volvieron de una copia de seguridad). La identidad que contiene no se puede recuperar; se puede generar una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration scellée ne peut pas être ouverte : la clé qui l’a scellée n’est plus dans le trousseau de cet iPhone (l’iPhone a été effacé, ou les données de Skywire sont revenues d’une sauvegarde). L’identité qu’elle contient est irrécupérable ; une nouvelle peut être générée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开已加密的配置：加密它的密钥已不在这台 iPhone 的钥匙串中（iPhone 已被抹掉，或 Skywire 的数据是从备份恢复的）。其中的身份无法恢复；可以生成一个新的身份。"
          }
        }
      }
    },
    "core_sealed_unreadable" : {
