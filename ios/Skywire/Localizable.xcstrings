          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo escribir el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n’a pas pu être écrit."
          }
        },
