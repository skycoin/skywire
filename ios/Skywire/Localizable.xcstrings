    "chat_list_catalog_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On means anyone who knows this visor's public key can discover this channel by asking it. Off keeps it reachable only by its address or an invite link. An admin can change this later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado, cualquiera que conozca la clave pública de este nodo puede descubrir este canal preguntándole. Desactivado, solo se llega a él por su dirección o por un enlace de invitación. Un administrador puede cambiar esto más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé, quiconque connaît la clé publique de ce visor peut découvrir cette chaîne en l’interrogeant. Désactivé, la chaîne n’est accessible que par son adresse ou un lien d’invitation. Un administrateur peut modifier ce choix plus tard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，任何知道本节点公钥的人都可以通过向它查询发现此频道。关闭后，只能通过频道地址或邀请链接访问。管理员之后可以更改此设置。"
          }
        }
      }
    },
    "chat_list_visor_catalog" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
