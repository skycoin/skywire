    },
    "hops_hint_direct" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A direct route to the exit — the quickest the network can be. The exit still cannot read your traffic, but it does see that this device is the one asking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ruta directa a la salida: lo más rápido que la red puede ser. La salida sigue sin poder leer tu tráfico, pero sí ve que este dispositivo es el que pregunta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直连出口的路由，也是这个网络能达到的最快方式。出口依然无法读取你的流量，但它会看到发起请求的正是这台设备。"
          }
        }
      }
    },
    "hops_hint_multi" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traffic is relayed through intermediaries, so no single node sees both who is asking and what is being asked. Slower, and every hop is another machine that has to stay up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tráfico pasa por intermediarios, así que ningún nodo ve a la vez quién pregunta y qué se pregunta. Más lento, y cada salto es otra máquina que tiene que seguir en pie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流量经中间节点转发，因此没有任何一个节点能同时看到是谁在请求、请求的又是什么。速度更慢，而且每多一跳，就多一台必须保持在线的机器。"
          }
        }
      }
    },
    "hops_hint_needs_autoconnect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only one hop is available: routing through intermediaries needs open transports to public visors, which is off. Turn on “Connect to public visors” in Settings to use 2 or 3 hops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo hay un salto disponible: enrutar a través de intermediarios necesita transportes abiertos hacia nodos públicos, y eso está desactivado. Activa «Conectar con nodos públicos» en Ajustes para usar 2 o 3 saltos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前只能使用 1 跳：经中间节点路由需要与公共节点保持开放的传输通道，而该功能已关闭。在设置中开启“连接公共节点”后即可使用 2 跳或 3 跳。"
          }
        }
      }
    },
    "hops_hint_unknown" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for the visor to report its routing settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando a que el nodo informe de sus ajustes de enrutamiento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待节点报告它的路由设置。"
          }
        }
      }
    },
