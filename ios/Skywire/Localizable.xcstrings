    "wallet_add_token_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every ERC-20 token lives on Ethereum and differs only in its contract. The decimals must match the contract’s own — 6 for USDT-like tokens, 18 for most — or amounts will read wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los tokens ERC-20 viven en Ethereum y solo se diferencian en su contrato. Los decimales tienen que coincidir con los del propio contrato —6 para los tipo USDT, 18 para la mayoría— o las cantidades se leerán mal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ERC-20 代币都运行在以太坊上，彼此之间只有合约不同。小数位必须与合约本身一致：USDT 这类代币为 6 位，多数代币为 18 位，否则金额会显示错误。"
          }
        }
      }
    },
