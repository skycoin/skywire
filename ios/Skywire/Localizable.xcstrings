    "fleet_enable_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets your own visors reach this phone over DMSG and report their status here. Off by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que tus propios nodos alcancen este teléfono por DMSG e informen aquí de su estado. Desactivado por defecto."
