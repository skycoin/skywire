      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cost to ask to join"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coste de solicitar unirse"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coût d’une demande d’adhésion"
          }
        },
