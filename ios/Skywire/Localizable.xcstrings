    "wallet_max" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máx."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部"
          }
        }
      }
    },
    "wallet_max_note_btc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max spends every confirmed output and subtracts the miner fee, so the amount moves with the rate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máx. gasta todas las salidas confirmadas y resta la comisión del minero, así que la cantidad se mueve con la tarifa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max dépense chaque sortie confirmée et soustrait les frais de minage, donc le montant bouge avec le taux."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“全部”会花掉每一笔已确认的输出并扣除矿工费，因此金额会随费率变动。"
          }
        }
      }
    },
    "wallet_max_note_erc20" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max sends the whole token balance. Gas is paid in ETH from the same address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máx. envía todo el saldo del token. El gas se paga en ETH desde la misma dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max envoie tout le solde du jeton. Le gaz est payé en ETH depuis la même adresse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“全部”会发送全部代币余额。Gas 仍从同一地址的 ETH 中扣除。"
          }
        }
      }
    },
    "wallet_max_note_eth" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max holds back a little ETH for gas; the exact remainder is computed when you review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máx. reserva un poco de ETH para el gas; el resto exacto se calcula al revisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max retient un peu d’ETH pour le gaz ; le reste exact est calculé au moment de la vérification."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“全部”会预留少量 ETH 用作 Gas，确切金额在预览页计算。"
          }
        }
      }
    },
    "wallet_max_note_fiber" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max sends every %1$@. Coin Hours are not sent — a share of them is burned as the fee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máx. envía todos los %1$@. Los Coin Hours no se envían: una parte se quema como comisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max envoie la totalité des %1$@. Les Coin Hours ne sont pas envoyées — une part d’entre elles est brûlée comme frais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“全部”会发送所有 %1$@。币时不会转出——其中一部分会作为手续费被销毁。"
          }
        }
      }
    },
    "wallet_no_activity_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins you receive on this wallet will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las monedas que recibas en esta billetera aparecerán aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces reçues sur ce portefeuille apparaîtront ici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该钱包收到的币会显示在这里。"
          }
        }
      }
    },
