    "chat_contact_name_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept by your visor, so it shows everywhere you use it — including notifications and call screens — and never reaches the peer. It overrides whatever name they publish for themselves: a name you chose is never replaced by one they changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo guarda tu nodo, así que aparece en todos los sitios donde lo uses (también en las notificaciones y en las pantallas de llamada) y nunca llega al par. Tiene prioridad sobre el nombre que publique para sí: un nombre que elegiste nunca se sustituye por uno que haya cambiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservé par votre visor, il apparaît partout où vous l’utilisez — y compris dans les notifications et les écrans d’appel — et n’est jamais transmis au pair. Il remplace le nom que la personne publie elle-même : un nom que vous avez choisi n’est jamais écrasé par un nom qu’elle a modifié."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由你的节点保存，因此在你使用它的所有地方都会显示——包括通知和通话界面——且绝不会发送给对端。它会覆盖对方为自己公开的任何名称：你设置的名称永远不会被对方修改后的名称替换。"
          }
        }
      }
    },
