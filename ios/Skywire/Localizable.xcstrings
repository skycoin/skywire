    "vpn_skydns_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens .dmsg and .skynet names in every app while SkyVPN is on. Address a site by its key's DNS label, since a hex key is too long for DNS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre nombres .dmsg y .skynet en todas las apps mientras SkyVPN está activado. Escribe la dirección de un sitio con la etiqueta DNS de su clave: una clave en hexadecimal es demasiado larga para DNS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre les noms .dmsg et .skynet dans chaque application pendant que SkyVPN est actif. Adressez un site par l’étiquette DNS de sa clé, une clé hexadécimale étant trop longue pour DNS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyVPN 开启时，所有应用都能打开 .dmsg 和 .skynet 域名。请用公钥的 DNS 标签作为站点地址，十六进制公钥对 DNS 来说太长。"
          }
        }
      }
    },
