    },
    "home_hint_starting" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joining the Skywire network. The first connection can take a few minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrando en la red Skywire. La primera conexión puede tardar unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion au réseau Skywire. La première connexion peut prendre quelques minutes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
