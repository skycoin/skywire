    "wallet_restore_custom_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a 12 or 24 word recovery phrase. Older Skycoin wallets took any text as a seed, and every letter, capital and space counts. A typo restores a different, empty wallet. Only use this if your wallet really was made from such a seed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no es una frase de recuperación de 12 o 24 palabras. Las billeteras antiguas de Skycoin aceptaban cualquier texto como semilla, y cuenta cada letra, mayúscula y espacio. Un error restaura otra billetera vacía. Úsalo solo si tu billetera de verdad se creó con una semilla así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas une phrase de récupération de 12 ou 24 mots. Les anciens portefeuilles Skycoin acceptaient n’importe quel texte comme graine, et chaque lettre, majuscule et espace compte. Une faute restaure un autre portefeuille, vide. N’utilisez ceci que si votre portefeuille a vraiment été créé avec une telle graine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是 12 或 24 个词的助记词。早期的 Skycoin 钱包接受任意文本作为种子，每个字母、大小写和空格都算数。输错一处就会恢复出另一个空钱包。只有当你的钱包确实是用这样的种子创建时才使用此项。"
          }
        }
      }
    },
    "wallet_restore_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
