    "home_dmsg_reconnected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DMSG sessions closed: %1$lld. The visor is dialing again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiones DMSG cerradas: %1$lld. El nodo está volviendo a conectar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭的 DMSG 会话：%1$lld。节点正在重新连接。"
          }
        }
      }
    },
    "home_error_start" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The core did not come up. Check the process log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El núcleo no llegó a arrancar. Revisa el registro del proceso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核心未能启动。请查看进程日志。"
          }
        }
      }
    },
    "home_hint_disconnected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect starts the Skywire core on this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar inicia el núcleo de Skywire en este teléfono."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“连接”即可在本机启动 Skywire 核心。"
          }
        }
      }
    },
    "home_hint_starting" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joining the Skywire network. The first connection can take a few minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrando en la red Skywire. La primera conexión puede tardar unos minutos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在加入 Skywire 网络。首次连接可能需要几分钟。"
          }
        }
      }
    },
    "home_reconnect_dmsg" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnect DMSG"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
