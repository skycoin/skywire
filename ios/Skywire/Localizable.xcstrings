          "stringUnit" : {
            "state" : "translated",
            "value" : "已授权访问。核心下次启动时生效。"
          }
        }
      }
    },
    "settings_remote_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets one other visor — yours, on a desk — drive this one over the network: start and stop apps, change routing, read the logs. Nothing is reachable until a key is granted, and the granted key has full control, so it should be a machine you own. No shell or file access either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que otro nodo —el tuyo, en un escritorio— gobierne este por la red: iniciar y detener apps, cambiar el enrutamiento, leer los registros. Nada es alcanzable hasta que concedas una clave, y la clave concedida tiene control total, así que debería ser una máquina tuya. En ningún sentido hay acceso a la shell ni a los archivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许另一个节点——你自己桌上的那台——通过网络操作本节点：启动和停止应用、修改路由、读取日志。在授权公钥之前外部无法访问；被授权的公钥拥有完全控制权，因此只应授权你自己的设备。双向都不提供 shell 或文件访问。"
          }
        }
      }
    },
    "settings_remote_invalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not a visor public key — expected 66 hex characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es la clave pública de un nodo: se esperaban 66 caracteres hexadecimales."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是节点公钥——应为 66 位十六进制字符。"
          }
        }
      }
    },
