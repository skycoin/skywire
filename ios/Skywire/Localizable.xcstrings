        }
      }
    },
    "chat_list_visor_catalog_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On means anyone holding this visor's public key can discover it by asking. Off keeps it reachable only by address or invite link. Other admins publish their own copies independently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado, cualquiera que tenga la clave pública de este nodo puede descubrirlo preguntando. Desactivado, solo se llega a él por su dirección o por un enlace de invitación. Los demás administradores publican sus propias copias por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé, quiconque détient la clé publique de ce visor peut découvrir le groupe en l’interrogeant. Désactivé, le groupe n’est accessible que par son adresse ou un lien d’invitation. Les autres administrateurs publient leurs propres copies indépendamment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，任何持有本节点公钥的人都可以通过查询发现它。关闭后，只能通过地址或邀请链接访问。其他管理员会各自独立发布自己的副本。"
          }
        }
      }
    },
