    "settings_app_lock_hint_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks for Face ID, Touch ID or your passcode when Skywire opens and when you come back to it after about half a minute away. Also covers the app in the app switcher and while the screen is being recorded or mirrored. iOS does not let an app block screenshots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide Face ID, Touch ID o tu código cuando abres Skywire y cuando vuelves a ella tras medio minuto fuera. También tapa la app en el selector de apps y mientras la pantalla se graba o se duplica. iOS no permite que una app bloquee las capturas de pantalla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Skywire 时，以及离开约半分钟后再回到应用时，都会要求面容 ID、触控 ID 或设备密码。同时会在应用切换器中，以及屏幕被录制或镜像时遮住应用内容。iOS 不允许应用禁止截屏。"
          }
        }
      }
    },
    "settings_app_lock_unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone has no screen lock or enrolled biometric, so there is nothing to check against."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono no tiene bloqueo de pantalla ni datos biométricos registrados, así que no hay nada con lo que comprobarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这部手机既没有设置锁屏密码，也没有录入生物识别，因此无从校验。"
          }
        }
      }
    },
    "settings_app_version" : {
