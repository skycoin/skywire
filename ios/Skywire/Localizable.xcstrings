    "fleet_off_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleet lists the visors you run elsewhere — whether each one is up, what it is running, and for how long. You can restart one. Nothing else: no transports, no apps, no settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flota lista los nodos que ejecutas en otro sitio: si cada uno está en pie, qué está ejecutando y desde cuándo. Puedes reiniciar uno. Nada más: ni transportes, ni apps, ni ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleet liste les visors que vous faites tourner ailleurs — s’ils sont debout, ce qu’ils exécutent, et depuis combien de temps. Vous pouvez en redémarrer un. Rien d’autre : pas de transports, pas d’applications, pas de réglages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集群会列出你在别处运行的节点——每个是否在线、正在运行什么、已运行多久。你可以重启其中一个。除此之外没有别的：不涉及传输通道、应用和设置。"
          }
        }
      }
    },
    "fleet_off_reachable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning it on makes this phone reachable over DMSG as a status endpoint, so those visors can connect in. Only visors that already carry this phone’s key connect — and they still cannot control anything here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activarlo hace que este teléfono sea alcanzable por DMSG como punto de estado, para que esos nodos puedan conectarse. Solo se conectan los nodos que ya llevan la clave de este teléfono, y aun así no pueden controlar nada aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activer rend ce téléphone joignable via DMSG comme point d’état, pour que ces visors se connectent. Seuls les visors qui portent déjà la clé de ce téléphone se connectent — et ils ne peuvent quand même rien contrôler ici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后，这台手机会作为状态端点通过 DMSG 变得可达，那些节点便可连入。只有已经带有这台手机公钥的节点才能连接——而且它们依然无法控制这里的任何东西。"
          }
        }
      }
    },
    "fleet_off_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your other visors, from here"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus otros nodos, desde aquí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos autres visors, d’ici"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里看你的其他节点"
          }
        }
      }
    },
