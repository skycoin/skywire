        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Node unreachable. Balance and history last updated at %1$@, %2$@ ago. Sending is off until the node answers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se alcanza el nodo. El saldo y el historial se actualizaron por última vez a las %1$@, hace %2$@. No se puede enviar hasta que el nodo responda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
