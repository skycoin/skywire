    "chat_kind_private" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "private"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "privado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "privé"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私密"
          }
        }
      }
    },
    "chat_kind_private_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every join is a request you approve. Messages are encrypted, and the key is sent to a member only after you let them in — so a forwarded invite link on its own grants nothing. Membership, moderation and shared files are encrypted too: who you admit, remove, ban or mute is not readable from outside the group, and attachments are sealed on disk as well as in transit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada unión es una solicitud que tú apruebas. Los mensajes van cifrados y la clave solo se envía a un miembro después de que lo admitas, así que un enlace de invitación reenviado no da acceso por sí solo. La membresía, la moderación y los archivos compartidos también van cifrados: desde fuera del grupo no se puede ver a quién admites, quitas, expulsas o restringes, y los adjuntos van sellados tanto en el disco como en tránsito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque adhésion est une demande que vous approuvez. Les messages sont chiffrés, et la clé n’est envoyée à un membre qu’une fois que vous l’avez admis — un lien d’invitation transféré ne donne donc accès à rien à lui seul. La liste des membres, la modération et les fichiers partagés sont aussi chiffrés : personne hors du groupe ne peut voir qui vous admettez, retirez, bannissez ou réduisez au silence, et les pièces jointes sont scellées sur le disque comme en transit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次加入都需要你批准。消息是加密的，只有在你批准后，密钥才会发给该成员——所以单凭转发出去的邀请链接得不到任何权限。成员信息、管理操作和共享文件同样加密：群外的人无法得知你批准、移除、封禁或限制发言的是谁；附件不仅在传输中加密，在磁盘上也加密存储。"
          }
        }
      }
    },
    "chat_kind_private_label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private — you approve each request"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privado: apruebas cada solicitud"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
