      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This address has sent coins before, so its public key is on the blockchain. A future quantum computer could use it to steal coins sent here. Use a new address instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dirección ya ha enviado monedas, así que su clave pública está en la cadena de bloques. Un futuro ordenador cuántico podría usarla para robar las monedas que se envíen aquí. Usa una dirección nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette adresse a déjà envoyé des pièces, sa clé publique est donc sur la blockchain. Un futur ordinateur quantique pourrait s’en servir pour voler les pièces envoyées ici. Utilisez plutôt une nouvelle adresse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个地址发送过币，公钥已在区块链上公开。未来的量子计算机可能借此偷走发到这里的币。请改用新地址。"
          }
        }
      }
