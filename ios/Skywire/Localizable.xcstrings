    "settings_remote_dialog_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the public key of the controlling visor — “skywire cli visor pk” on that machine prints it. That machine gains full control of this visor the next time the core starts, and appears in its hypervisor list as this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega la clave pública del nodo que va a gobernar: «skywire cli visor pk» la imprime en esa máquina. Esa máquina obtendrá control total de este nodo la próxima vez que arranque el núcleo, y este teléfono aparecerá en su lista de hipervisores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez la clé publique du visor de contrôle — « skywire cli visor pk » sur cette machine l’affiche. Cette machine gagne le contrôle total de ce visor au prochain démarrage du cœur, et apparaît dans sa liste d’hyperviseurs comme ce téléphone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴控制端节点的公钥——在那台机器上运行“skywire cli visor pk”即可打印出来。核心下次启动后，那台机器将获得本节点的完全控制权，同时这部手机会出现在它的 hypervisor 列表中。"
          }
        }
      }
    },
