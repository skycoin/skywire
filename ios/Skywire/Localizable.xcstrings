    "wallet_node_list_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requests try these addresses in order — the first is the highest priority, and the shipped node is the fallback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las peticiones prueban estas direcciones en orden: la primera es la de mayor prioridad, y el nodo de fábrica es el último recurso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes essaient ces adresses dans l’ordre — la première a la plus haute priorité, et le nœud livré sert de repli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求会按顺序尝试这些地址——排在最前的优先级最高，内置节点作为兜底。"
          }
        }
      }
    },
    "wallet_node_mesh" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reached over the Skywire mesh, encrypted end to end. The node sees this phone's Skywire key, not its internet address. Works while Skywire is connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanza por la red Skywire, cifrado de extremo a extremo. El nodo ve la clave Skywire de este teléfono, no su dirección de internet. Funciona mientras Skywire está conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joint par le maillage Skywire, chiffré de bout en bout. Le nœud voit la clé Skywire de ce téléphone, pas son adresse internet. Fonctionne tant que Skywire est connecté."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Skywire 网络访问，端到端加密。节点服务器看到的是这部手机的 Skywire 公钥，而不是它的网络地址。Skywire 连接时才可用。"
          }
        }
      }
    },
