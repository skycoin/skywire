    "settings_app_lock_hint_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks for Face ID, Touch ID or your passcode when Skywire opens and when you come back to it after about half a minute away. Also covers the app in the app switcher and while the screen is being recorded or mirrored. iOS does not let an app block screenshots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide Face ID, Touch ID o tu código cuando abres Skywire y cuando vuelves a ella tras medio minuto fuera. También tapa la app en el selector de apps y mientras la pantalla se graba o se duplica. iOS no permite que una app bloquee las capturas de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande Face ID, Touch ID ou votre code quand Skywire s’ouvre et quand vous y revenez après environ une demi-minute d’absence. Masque aussi l’app dans le sélecteur d’apps et pendant que l’écran est enregistré ou recopié. iOS ne permet pas à une app de bloquer les captures d’écran."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Skywire 时，以及离开约半分钟后再回到应用时，都会要求面容 ID、触控 ID 或设备密码。同时会在应用切换器中，以及屏幕被录制或镜像时遮住应用内容。iOS 不允许应用禁止截屏。"
          }
        }
      }
    },
    "settings_app_lock_unavailable_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone has no passcode, so there is nothing to check against. One is set in the Settings app, under Face ID & Passcode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no tiene código, así que no hay nada con qué comprobar. Se pone en la app Ajustes, en Face ID y código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone n’a pas de code, donc il n’y a rien à vérifier. Un code se définit dans l’app Réglages, sous Face ID et code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 没有设置密码，因此无从验证。可在“设置”App 的“面容 ID 与密码”中设置。"
          }
        }
      }
    },
