    "chat_kind_public_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone holding the invite link is admitted automatically. Messages are not encrypted on the feed: in an open group the key would go to anyone who asks, so it would protect nothing. Traffic is still encrypted in transit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que tenga el enlace de invitación entra automáticamente. Los mensajes no van cifrados en el feed: en un grupo abierto la clave se daría a cualquiera que la pidiera, así que no protegería nada. El tráfico sigue cifrado en tránsito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque détient le lien d’invitation est admis automatiquement. Les messages ne sont pas chiffrés dans le flux : dans un groupe ouvert, la clé irait à quiconque la demande, elle ne protégerait donc rien. Le trafic reste chiffré en transit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何持有邀请链接的人都会被自动接纳。消息在信息流上不加密：开放群组的密钥会发给任何索要的人，加密起不到任何保护作用。传输过程仍然是加密的。"
          }
        }
      }
    },
