    "settings_sk_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the 64-character secret key you want this phone to run as. It is checked by the Skywire core before anything changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega la clave secreta de 64 caracteres con la que quieres que funcione este teléfono. El núcleo de Skywire la comprueba antes de cambiar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez la clé secrète de 64 caractères sous laquelle vous voulez que ce téléphone tourne. Elle est vérifiée par le cœur Skywire avant tout changement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴你想让这部手机使用的 64 字符私钥。Skywire 核心会先校验，之后才会改动任何内容。"
          }
        }
      }
    },
