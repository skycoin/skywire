    "settings_encrypt_warning_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this iPhone is erased, or Skywire’s data is restored from a backup, the sealing key is gone and the identity in the config cannot be recovered. Export the config first if it matters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si este iPhone se borra, o los datos de Skywire se restauran desde una copia de seguridad, la clave de sellado desaparece y la identidad de la configuración no se puede recuperar. Exporta la configuración antes si te importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cet iPhone est effacé, ou si les données de Skywire sont restaurées depuis une sauvegarde, la clé de scellement disparaît et l’identité de la configuration ne peut pas être récupérée. Exportez d’abord la configuration si elle compte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果这台 iPhone 被抹掉，或 Skywire 的数据从备份恢复，加密密钥就会丢失，配置中的身份将无法恢复。如果它很重要，请先导出配置。"
          }
        }
      }
    },
