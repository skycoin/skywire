    "wallet_stale_banner" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Node unreachable. Balance and history last updated at %1$@, %2$@ ago. Sending is off until the node answers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se alcanza el nodo. El saldo y el historial se actualizaron por última vez a las %1$@, hace %2$@. No se puede enviar hasta que el nodo responda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nœud injoignable. Solde et historique actualisés pour la dernière fois à %1$@, il y a %2$@. L’envoi est coupé jusqu’à ce que le nœud réponde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接节点服务器。余额和历史记录最后更新于 %1$@，距今 %2$@。在节点服务器恢复响应前无法发送。"
          }
        }
      }
    },
    "wallet_stale_never" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Node unreachable. This wallet has not synced yet — balances show once the node answers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se alcanza el nodo. Esta billetera aún no se ha sincronizado: los saldos aparecerán cuando el nodo responda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
