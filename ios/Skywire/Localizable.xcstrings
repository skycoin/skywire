    "net_addr_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device’s own address does not change when SkyVPN connects: the app carries the tunnel, so its own traffic has to stay outside it. What changes is where your other apps’ traffic leaves the network — the exit above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección propia de este dispositivo no cambia cuando SkyVPN se conecta: la app transporta el túnel, así que su propio tráfico tiene que quedarse fuera de él. Lo que cambia es por dónde sale de la red el tráfico de tus otras apps: la salida de arriba."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 SkyVPN 后，本机地址不会改变：隧道由本应用承载，它自身的流量必须留在隧道之外。改变的是其他应用的流量从哪里离开网络，也就是上面的出口。"
          }
        }
      }
    },
