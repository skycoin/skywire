    "wallet_restore_legacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phrase carries no checksum — the older wallets wrote their seeds that way, so it may still be a good one. Check every word, then press again to restore anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta frase no lleva suma de verificación — las carteras antiguas escribían sus semillas así, así que puede seguir siendo válida. Revisa cada palabra y pulsa de nuevo para restaurar de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette phrase ne porte pas de somme de contrôle — les anciens portefeuilles écrivaient leurs graines ainsi, elle peut donc quand même être bonne. Vérifiez chaque mot, puis appuyez de nouveau pour restaurer quand même."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这组助记词没有校验和——旧版钱包的助记词就是这样，因此它仍可能是有效的。请逐词核对后，再按一次以仍然恢复。"
          }
        }
      }
    },
