    "settings_language_hint_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change it in the iOS Settings app, under Skywire › Language. Logs and whatever the visor itself reports stay in English — they are read next to a desktop’s, and a translated log line is one nobody can search for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cambia en la app Ajustes de iOS, en Skywire › Idioma. Los registros y todo lo que informa el propio nodo se quedan en inglés: se leen junto a los de un escritorio, y una línea de registro traducida es una línea que nadie puede buscar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iOS 的“设置”应用中前往“Skywire › 语言”更改。日志和节点自身报告的内容仍为英文——它们要与桌面端的日志放在一起看，翻译过的日志行没有人能搜到。"
          }
        }
      }
    },
