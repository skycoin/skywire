    "fleet_confirm_restart_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Skywire core reads this setting only when it starts, so it has to be restarted. Any SkySOCKS or SkyVPN connection drops and has to be reconnected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El núcleo de Skywire lee este ajuste solo al arrancar, así que hay que reiniciarlo. Cualquier conexión de SkySOCKS o SkyVPN se cae y habrá que reconectarla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire 核心只在启动时读取该设置，因此必须重启。任何 SkySOCKS 或 SkyVPN 连接都会中断，需要重新连接。"
          }
        }
      }
    },
    "fleet_core_offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
