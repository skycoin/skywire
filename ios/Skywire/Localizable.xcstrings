    "diag_level_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much the visor writes. Debug and trace are for reproducing a problem — on a phone they are a lot of writing for a log nobody is reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto escribe el nodo. Debug y trace son para reproducir un problema: en un teléfono son muchísima escritura para un registro que nadie está leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien le visor écrit. Debug et trace servent à reproduire un problème — sur un téléphone, c’est beaucoup d’écriture pour un journal que personne ne lit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节点记录多少内容。debug 和 trace 用于复现问题——在手机上会写入大量没人会看的日志。"
