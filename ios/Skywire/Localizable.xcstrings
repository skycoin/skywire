          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接节点服务器。余额和历史记录最后更新于 %1$@，距今 %2$@。在节点服务器恢复响应前无法发送。"
          }
        }
      }
    },
