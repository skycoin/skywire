      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire tries this type first when it connects, and falls back to the others when it can’t. Takes effect on the next connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire prueba este tipo primero al conectarse y recurre a los demás cuando no puede. Se aplica en la siguiente conexión."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire 连接时会先尝试这一类型，无法建立时再回退到其他类型。下次连接时生效。"
          }
        }
      }
    },
