    "mail_address_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone on Skywire can write to this address, and any name before the @ reaches you. SkyMail travels only on the Skywire network: it does not reach ordinary e-mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera en Skywire puede escribirte a esta dirección, y cualquier nombre antes de la @ te llega. SkyMail viaja solo por la red Skywire: no llega al correo electrónico común."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque est sur Skywire peut écrire à cette adresse, et tout nom avant le @ vous atteint. SkyMail voyage uniquement sur le réseau Skywire : il n’atteint pas le courrier électronique ordinaire."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire 上的任何人都能给这个地址写信，@ 前面写什么名字都能送到你这里。SkyMail 只在 Skywire 网络里传递，不会送到普通电子邮箱。"
          }
        }
      }
    },
