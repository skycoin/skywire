    "wallet_fee_note_erc20" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token transfers burn gas, and gas is paid in ETH from the sending address — keep a little ETH next to the tokens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transferencias de tokens queman gas, y el gas se paga en ETH desde la dirección que envía: ten siempre un poco de ETH junto a los tokens."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transferts de jetons brûlent du gaz, et le gaz est payé en ETH depuis l’adresse d’envoi — gardez un peu d’ETH à côté des jetons."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代币转账会消耗 Gas，而 Gas 由发送地址中的 ETH 支付——请在存放代币的地址里留一点 ETH。"
          }
        }
      }
    },
    "wallet_fee_note_eth" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fee shown is the worst case at today’s prices — unspent gas is never charged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comisión que se muestra es el peor caso a los precios de hoy: el gas que no se usa nunca se cobra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les frais affichés sont le pire cas aux prix du jour — le gaz non dépensé n’est jamais facturé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示的是按当前价格计算的最高手续费——未用完的 Gas 不会收取。"
          }
        }
      }
    },
    "wallet_fee_note_fiber" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ transactions cost no %1$@. One tenth of the Coin Hours entering the transaction is burned as the fee, and half of what remains moves on with the coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transacciones de %1$@ no cuestan %1$@. Una décima parte de los Coin Hours que entran en la transacción se quema como comisión, y la mitad de lo que queda sigue adelante con las monedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transactions %1$@ ne coûtent pas de %1$@. Un dixième des Coin Hours entrant dans la transaction est brûlé comme frais, et la moitié du reste suit les pièces."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 交易不消耗 %1$@。进入交易的币时会有十分之一作为手续费被销毁，剩下的一半随币一同转出。"
          }
        }
      }
    },
