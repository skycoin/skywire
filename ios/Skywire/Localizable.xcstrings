    "vpn_ios_pending" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyVPN arrives with the build of Skywire that runs on an iPhone. Until then the tunnel stays off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyVPN llega con la versión de Skywire que funciona en un iPhone. Hasta entonces, el túnel sigue apagado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyVPN 将随可在 iPhone 上运行的 Skywire 版本一起推出。在此之前，隧道保持关闭。"
          }
        }
      }
    },
    "vpn_killswitch_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the network interface in place while the tunnel is down, so nothing leaks out around it. Other apps have no connection until it comes back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la interfaz de red en pie mientras el túnel está caído, para que nada se escape por fuera. Las demás apps se quedan sin conexión hasta que vuelva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隧道断开时保留网络接口，使流量不会绕过它泄漏出去。在隧道恢复之前，其他应用将无法联网。"
          }
        }
      }
    },
