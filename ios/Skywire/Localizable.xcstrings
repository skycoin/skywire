    "transport_stcpr_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct TCP to the server. Fastest when it works, but needs reachability a mobile network rarely gives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP directo al servidor. El más rápido cuando funciona, pero necesita una accesibilidad que una red móvil rara vez da."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直连服务器的 TCP。可用时最快，但移动网络很少能提供它所需的可达性。"
          }
        }
      }
    },
