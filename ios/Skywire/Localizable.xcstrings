      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The complete visor configuration, as a file you keep. It is the only way to move this identity to another device or bring it back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración completa del nodo, como un archivo que te quedas. Es la única forma de llevar esta identidad a otro dispositivo o de recuperarla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整的节点配置，导出为一个由你自己保管的文件。这是把该身份迁移到其他设备或日后找回的唯一途径。"
          }
        }
      }
    },
