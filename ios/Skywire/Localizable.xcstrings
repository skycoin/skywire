    "mail_send_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail goes out now, over dmsg for a .dmsg address. A recipient whose visor is offline does not get it, and nothing retries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El correo sale ahora, por dmsg para una dirección .dmsg. Si el nodo del destinatario está desconectado, no lo recibe y nada lo reintenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le courrier part maintenant, via dmsg pour une adresse .dmsg. Un destinataire dont le visor est hors ligne ne le reçoit pas, et rien ne réessaie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件会立即发出，.dmsg 地址走 dmsg。收件人的节点离线时收不到，也不会重试。"
          }
        }
      }
    },
