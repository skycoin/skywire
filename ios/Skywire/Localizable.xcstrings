    },
    "chat_backfill_admin_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off means only admins can, so nothing reaches a new member — and no message passes between two non-admins — while every admin is offline. On, each member keeps a copy of the room; only members can read it either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado, solo pueden hacerlo los administradores, así que mientras todos los administradores estén desconectados no le llega nada a un miembro nuevo, ni pasa ningún mensaje entre dos miembros que no sean administradores. Activado, cada miembro guarda una copia de la sala; en ambos casos solo los miembros pueden leerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, seuls les administrateurs le peuvent : rien ne parvient alors à un nouveau membre — et aucun message ne passe entre deux non-administrateurs — tant que tous les administrateurs sont hors ligne. Activé, chaque membre garde une copie du groupe ; dans les deux cas, seuls les membres peuvent la lire."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时只有管理员可以分享，因此当所有管理员都离线时，新成员收不到任何内容，两名非管理员之间也无法传递消息。开启后，每位成员都会保存一份群聊副本；无论哪种方式，都只有成员能读取。"
          }
        }
      }
    },
    "chat_backfill_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off means only admins can — the group goes quiet for everyone else whenever no admin is online. On costs each member some storage, since they keep a copy of the room. Either way only members can read it, and an admin can change this later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado, solo pueden hacerlo los administradores, y el grupo se queda en silencio para todos los demás cuando no hay ningún administrador en línea. Activado, cada miembro gasta algo de almacenamiento, porque guarda una copia de la sala. En ambos casos solo los miembros pueden leerla, y un administrador puede cambiar esto más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, seuls les administrateurs le peuvent — le groupe devient silencieux pour tous les autres dès qu’aucun administrateur n’est en ligne. Activé, chaque membre utilise un peu de stockage, puisqu’il garde une copie du groupe. Dans les deux cas, seuls les membres peuvent en lire le contenu, et un administrateur peut modifier ce choix plus tard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时只有管理员可以分享——只要没有管理员在线，其他人就收不到群内的任何新内容。开启后每位成员都要保存一份群聊副本，会占用一些存储空间。无论哪种方式都只有成员能读取，管理员之后也可以更改此设置。"
          }
        }
      }
    },
