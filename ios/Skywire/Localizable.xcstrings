    "settings_dns_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyVPN and SkyDNS ask this server for every name that is not .dmsg or .skynet, over DNS-over-TLS when the server offers it, as Cloudflare, Google and Quad9 do. Left empty, SkyVPN uses 1.1.1.1 (Cloudflare), because a VPN server has no resolver to share, and SkyDNS on its own uses this phone's DNS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyVPN y SkyDNS le preguntan a este servidor por cada nombre que no sea .dmsg ni .skynet, con DNS sobre TLS cuando el servidor lo ofrece, como hacen Cloudflare, Google y Quad9. Si lo dejas vacío, SkyVPN usa 1.1.1.1 (Cloudflare), porque un servidor VPN no tiene un resolvedor que compartir, y SkyDNS por sí solo usa el DNS de este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyVPN et SkyDNS demandent à ce serveur chaque nom qui n’est ni .dmsg ni .skynet, via DNS-over-TLS quand le serveur l’offre, comme le font Cloudflare, Google et Quad9. Laissé vide, SkyVPN utilise 1.1.1.1 (Cloudflare), parce qu’un serveur VPN n’a pas de résolveur à partager, et SkyDNS seul utilise le DNS de ce téléphone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkyVPN 和 SkyDNS 会向此服务器查询所有不以 .dmsg 或 .skynet 结尾的域名；服务器支持时使用 DNS over TLS，Cloudflare、Google 和 Quad9 都支持。留空时，SkyVPN 使用 1.1.1.1（Cloudflare），因为 VPN 服务器没有可共享的解析服务；单独运行的 SkyDNS 则使用本机的 DNS。"
          }
        }
      }
    },
    "settings_dns_invalid" : {
      "extractionState" : "manual",
