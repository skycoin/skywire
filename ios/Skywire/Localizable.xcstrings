    "dex_wallets_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Skycoin address receives every purchased sell coin (SKY and any fibercoin share the format) and any refund. To sell, add a payout address for each payment coin you’ll accept — that’s where buyers pay you directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dirección de Skycoin recibe todas las monedas que compres (SKY y cualquier fibercoin comparten el formato) y cualquier reembolso. Para vender, añade una dirección de cobro para cada moneda de pago que aceptes: ahí te pagan directamente los compradores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre adresse Skycoin reçoit chaque monnaie achetée (SKY et toutes les fibercoins partagent le format) ainsi que les remboursements. Pour vendre, ajoutez une adresse de réception pour chaque monnaie de paiement que vous acceptez : c’est là que les acheteurs vous paient directement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Skycoin 地址接收你购买的所有币（SKY 和所有 fibercoin 共用同一地址格式）以及任何退款。若要出售，请为你接受的每种支付币添加一个收款地址，买家会直接向该地址付款。"
          }
        }
      }
    },
