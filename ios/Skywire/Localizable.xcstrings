    "settings_reward_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste your wallet's account xpub (BIP 44, account level) to earn Skywire rewards. Each reward goes to a fresh address derived from it. A wallet's extended public keys in Wallet can set it directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega el xpub de cuenta de tu billetera (BIP 44, nivel de cuenta) para ganar recompensas de Skywire. Cada recompensa va a una dirección nueva derivada de él. Las claves públicas extendidas de una billetera en Billetera pueden configurarlo directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez le xpub de compte de votre portefeuille (BIP 44, niveau compte) pour gagner des récompenses Skywire. Chaque récompense va à une nouvelle adresse dérivée de celui-ci. Les clés publiques étendues d'un portefeuille, dans Portefeuille, peuvent le définir directement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴钱包的账户 xpub（BIP 44 账户层级）即可获得 Skywire 奖励。每笔奖励都会发送到由它派生的新地址。也可以在钱包中打开钱包的扩展公钥直接设置。"
          }
        }
      }
    },
    "settings_reward_invalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter an account xpub. It starts with xpub; a single address is not accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un xpub de cuenta. Empieza por xpub; no se acepta una dirección suelta."
          }
        },
        "fr" : {
