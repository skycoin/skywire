    "diag_footprint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory in use"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria en uso"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "占用内存"
          }
        }
      }
    },
    "diag_footprint_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What iOS counts against this app (phys_footprint), the core included. On a device the core will run in a packet-tunnel extension, whose limit is about 50 MB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que iOS le cuenta a esta app (phys_footprint), núcleo incluido. En un dispositivo, el núcleo se ejecutará en una extensión de túnel de paquetes, cuyo límite ronda los 50 MB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 计入本应用的内存用量（phys_footprint），包括核心。在真机上，核心将运行在数据包隧道扩展中，其上限约为 50 MB。"
          }
        }
      }
    },
    "diag_level" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Core log level"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivel de registro del núcleo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核心日志级别"
          }
        }
      }
    },
    "diag_level_confirm_action" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiniciar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重启"
          }
        }
      }
    },
    "diag_level_confirm_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Skywire core reads this only when it starts, so it has to be restarted. Any SkySOCKS or SkyVPN connection drops and has to be reconnected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El núcleo de Skywire lee esto solo al arrancar, así que hay que reiniciarlo. Cualquier conexión de SkySOCKS o SkyVPN se cae y habrá que reconectarla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire 核心只在启动时读取该设置，因此必须重启。所有 SkySOCKS 或 SkyVPN 连接都会中断，需要重新连接。"
          }
        }
      }
    },
    "diag_level_confirm_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the log level to %1$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Poner el nivel de registro en %1$@?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将日志级别设为 %1$@？"
          }
        }
      }
    },
    "diag_level_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much the visor writes. Debug and trace are for reproducing a problem — on a phone they are a lot of writing for a log nobody is reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto escribe el nodo. Debug y trace son para reproducir un problema: en un teléfono son muchísima escritura para un registro que nadie está leyendo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节点记录多少内容。debug 和 trace 用于复现问题——在手机上会写入大量没人会看的日志。"
          }
        }
      }
    },
    "diag_source_app_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app’s log, as the visor keeps it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de esta app, tal como lo guarda el nodo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用的日志，由节点保存。"
          }
        }
      }
    },
    "diag_source_core_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The visor’s own runtime log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de ejecución del propio nodo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节点自身的运行日志。"
          }
        }
      }
    },
    "diag_source_process_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the core process printed — the only feed that survives a visor that will not start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que imprimió el proceso del núcleo: la única fuente que sobrevive a un nodo que no arranca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核心进程输出的内容——节点无法启动时，只剩这一份日志可看。"
          }
        }
      }
    },
    "diag_sources" : {
