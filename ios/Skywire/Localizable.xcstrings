        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El núcleo de Skywire lee este ajuste solo al arrancar, así que hay que reiniciarlo. Cualquier conexión de SkySOCKS o SkyVPN se cae y habrá que reconectarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cœur Skywire ne lit ce réglage qu’au démarrage, il doit donc être redémarré. Toute connexion SkySOCKS ou SkyVPN est coupée et devra être relancée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skywire 核心只在启动时读取该设置，因此必须重启。任何 SkySOCKS 或 SkyVPN 连接都会中断，需要重新连接。"
          }
        }
      }
    },
