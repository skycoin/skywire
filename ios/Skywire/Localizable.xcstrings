    "dex_market_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market to trade on. Connecting dials it over Skywire and opens its trading screen below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mercado en el que operar. Al conectar se le llama por Skywire y se abre su pantalla de trading aquí abajo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要交易的市场。连接后会通过 Skywire 接入该市场，并在下方打开它的交易界面。"
          }
        }
      }
    },
