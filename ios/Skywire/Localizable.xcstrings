    "wallet_intro_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your keys are created on this device and stay on this device. Skywire never sees them, and they are never sent to the network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus claves se crean en este dispositivo y se quedan en este dispositivo. Skywire nunca las ve, y nunca se envían a la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos clés sont créées sur cet appareil et y restent. Skywire ne les voit jamais, et elles ne sont jamais envoyées au réseau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥在本设备上生成，也只留在本设备上。Skywire 看不到它们，它们也不会被发送到网络。"
          }
        }
      }
    },
