    "wallet_node_encrypted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted in transit. A node still sees which addresses you ask about together, but nobody else on the way does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrado en tránsito. El nodo sigue viendo qué direcciones consultas juntas, pero nadie más por el camino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffré en transit. Un nœud voit quand même quelles adresses vous demandez ensemble, mais personne d’autre sur la route."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传输已加密。节点仍能看到你一并查询了哪些地址，但链路上的其他人看不到。"
          }
        }
      }
    },
