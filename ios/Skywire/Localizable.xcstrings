    "chat_import_evicted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dropped by the per-conversation limit (--persist-per-peer-cap keeps the newest)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ descartados por el límite por conversación (--persist-per-peer-cap conserva los más recientes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écartés par la limite par conversation : %1$@ (--persist-per-peer-cap conserve les plus récents)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 条因超出单个会话的上限而被丢弃（--persist-per-peer-cap 会保留最新的消息）。"
          }
        }
      }
    },
    "chat_import_expiring" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ are older than the retention window and will be swept (--persist-ttl 0 keeps them)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ superan el periodo de retención y se borrarán (--persist-ttl 0 los conserva)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus anciens que la durée de conservation, bientôt purgés : %1$@ (--persist-ttl 0 les conserve)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 条已超出保留期限，将被清理（使用 --persist-ttl 0 可保留它们）。"
          }
        }
      }
    },
