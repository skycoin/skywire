    "settings_encrypt_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seals the config file whenever Skywire is disconnected, under a key this phone will not hand out. Protects the secret key if the device is examined; it makes no difference while you are connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sella el archivo de configuración siempre que Skywire esté desconectada, bajo una clave que este teléfono no entregará. Protege la clave secreta si examinan el dispositivo; no cambia nada mientras estás conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scelle le fichier de configuration chaque fois que Skywire est déconnecté, sous une clé que ce téléphone ne distribuera pas. Protège la clé secrète si l’appareil est examiné ; ne change rien pendant que vous êtes connecté."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每当 Skywire 断开连接时，用一把本机不会交出的密钥封存配置文件。设备被检查时可以保护私钥；连接期间则没有区别。"
          }
        }
      }
    },
