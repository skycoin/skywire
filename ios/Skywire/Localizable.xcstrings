    "settings_export_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file contains this visor’s secret key in plain text. Anyone who reads it can run as this visor. Save it somewhere only you can reach — not a shared drive, not a chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo contiene la clave secreta de este nodo en texto plano. Cualquiera que lo lea puede hacerse pasar por este nodo. Guárdalo donde solo tú puedas llegar: ni en una unidad compartida, ni en un chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient la clé secrète de ce visor en clair. Quiconque le lit peut se faire passer pour ce visor. Enregistrez-le quelque part où vous seul avez accès — pas un lecteur partagé, pas un chat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件中以明文包含本节点的私钥。任何人读到它，都能以本节点的身份运行。请存放在只有你能访问的地方——不要放共享网盘，也不要发到聊天里。"
          }
        }
      }
    },
    "settings_identity" : {
      "extractionState" : "manual",
      "localizations" : {
