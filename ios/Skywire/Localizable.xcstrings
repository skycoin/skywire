      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The balance is up to date, but this wallet's %1$@ transaction list has not come through yet. It can be large on a slow connection — pull to refresh to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El saldo está al día, pero la lista de transacciones de %1$@ de esta billetera todavía no ha llegado. Puede ser grande con una conexión lenta: desliza hacia abajo para volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le solde est à jour, mais la liste de transactions %1$@ de ce portefeuille n’est pas encore arrivée. Elle peut être volumineuse sur une connexion lente — tirez pour actualiser et réessayer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "余额已是最新，但本钱包的 %1$@ 交易记录尚未获取到。在网络较慢时它可能很大——请下拉刷新重试。"
          }
        }
