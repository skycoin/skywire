    "wallet_pending_delete_confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove this transaction from this node's unconfirmed pool? It is not cancelled: other nodes that hold it can still confirm it. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar esta transacción del grupo sin confirmar de este nodo? No se cancela: otros nodos que la tengan aún pueden confirmarla. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer cette transaction du pool non confirmé de ce nœud ? Elle n’est pas annulée : d’autres nœuds qui la détiennent peuvent encore la confirmer. Cette action est irréversible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要从这个节点服务器的未确认交易池中移除这笔交易吗？交易不会被取消：持有它的其他节点仍可能确认它。此操作无法撤销。"
          }
        }
      }
    },
