      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One destination per line: the address, the amount and, if you like, the coin hours, separated by commas. Set hours on every line or on none."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un destino por línea: la dirección, la cantidad y, si quieres, las horas de moneda, separadas por comas. Pon horas en todas las líneas o en ninguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une destination par ligne : l’adresse, le montant et, si vous voulez, les Coin Hours, séparés par des virgules. Indiquez des heures sur toutes les lignes ou sur aucune."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行一个收款方：地址、金额，以及可选的币时，用逗号分隔。要么每行都写币时，要么都不写。"
          }
        }
      }
    },
