    "chat_qr_help_channel" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanning this opens the channel. It stays valid as the channel changes, but whoever scans it needs this host reachable to join."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al escanearlo se abre el canal. Sigue siendo válido aunque el canal cambie, pero quien lo escanee necesita que este anfitrión esté accesible para unirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanner ce code ouvre la chaîne. Il reste valable quand la chaîne évolue, mais pour la rejoindre, cet hôte doit être joignable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描后即可打开该频道。频道有变化时它依然有效，但扫码者需要能连上此托管节点才能加入。"
          }
        }
      }
    },
    "chat_qr_help_group" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanning this opens the group. It stays valid as the group changes, but whoever scans it needs this host reachable to join."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al escanearlo se abre el grupo. Sigue siendo válido aunque el grupo cambie, pero quien lo escanee necesita que este anfitrión esté accesible para unirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanner ce code ouvre le groupe. Il reste valable quand le groupe évolue, mais pour le rejoindre, cet hôte doit être joignable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描后即可打开该群组。群组有变化时它依然有效，但扫码者需要能连上此托管节点才能加入。"
          }
        }
      }
    },
