    "transport_stcpr_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct TCP to the server. Fastest when it works, but needs reachability a mobile network rarely gives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP directo al servidor. El más rápido cuando funciona, pero necesita una accesibilidad que una red móvil rara vez da."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP direct vers le serveur. Le plus rapide quand il marche, mais il exige une joignabilité qu’un réseau mobile donne rarement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直连服务器的 TCP。可用时最快，但移动网络很少能提供它所需的可达性。"
          }
        }
      }
    },
    "transport_sudph" : {
      "extractionState" : "manual",
