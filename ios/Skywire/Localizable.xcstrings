    "settings_identity_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone is a Skywire visor, and its key is what everything else addresses. Both actions below end that identity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono es un nodo Skywire, y su clave es la dirección con la que todo lo demás lo alcanza. Las dos acciones de abajo acaban con esa identidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone est un visor Skywire, et sa clé est ce à quoi tout le reste s’adresse. Les deux actions ci-dessous mettent fin à cette identité."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这部手机本身就是一个 Skywire 节点，其他一切都通过它的密钥来寻址。下面两项操作都会终结这个身份。"
          }
        }
      }
    },
    "settings_identity_loss" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will lose everything this phone holds as %1$@: its chat history and contacts, its groups, and the address other visors know it by. Nothing here is recoverable afterwards, and nothing moves to the new key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perderás todo lo que este teléfono guarda como %1$@: su historial de chat y sus contactos, sus grupos y la dirección por la que lo conocen otros nodos. Nada de esto se puede recuperar después, y nada pasa a la clave nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous perdrez tout ce que ce téléphone détient en tant que %1$@ : son historique de chat et ses contacts, ses groupes, et l’adresse par laquelle les autres visors le connaissent. Rien ici n’est récupérable ensuite, et rien ne passe à la nouvelle clé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这部手机以 %1$@ 身份保存的一切都会丢失：聊天记录和联系人、群组，以及其他节点认识它的那个地址。这些事后都无法恢复，也不会转移到新密钥上。"
          }
        }
      }
    },
    "settings_identity_none" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No identity yet. Connect once from the Home tab and one is generated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay identidad. Conéctate una vez desde la pestaña Inicio y se generará una."
