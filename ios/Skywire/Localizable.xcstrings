        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every address in To and Cc goes over this network. dmsg needs no route; skynet is faster when one exists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las direcciones de Para y Cc van por esta red. dmsg no necesita ruta; skynet es más rápido cuando hay una."
          }
