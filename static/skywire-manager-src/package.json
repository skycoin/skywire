    "@types/jasmine": "^6.0.0",
    "@types/node": "^25.5.0",
    "angular-eslint": "^21.3.0",
    "bootstrap": "^5.3.8",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
