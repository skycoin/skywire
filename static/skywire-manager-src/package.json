    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bignumber.js": "^10.0.2",
    "chart.js": "^4.5.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.0.0",
