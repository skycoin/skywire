{
  "name": "skywire-manager",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --ssl-cert \"./ssl/server.crt\" --ssl-key \"./ssl/server.key\" --proxy-config proxy.config.json",
    "start-no-ssl": "ng serve --proxy-config proxy.config.json",
    "build": "ng build --configuration production",
    "test": "ng test",
    "test-headless": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint",
    "lint-fix": "ng lint --fix"
  },
  "private": true,
