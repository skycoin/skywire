package ui2

// The states of the hypervisor's skycoin-web app for the wallet tab.
const (
	WalletRunning = "running"
	WalletStopped = "stopped"
	WalletMissing = "missing"
)

// WalletPage hosts skycoin-web's server rendered wallet, forwarded by the
// hypervisor at wallet/web/, and the coin node settings page.
templ WalletPage(pk, state string) {
	@VisorLayout(pk, "wallet") {
		switch state {
			case WalletRunning:
				@islandHead(T(ctx, "wallet.title"), T(ctx, "wallet.help"), "wallet/web/", T(ctx, "wallet.open-fullscreen"))
				<iframe class="island wallet" src="wallet/web/" title={ T(ctx, "wallet.title") }></iframe>
			case WalletStopped:
				<h1>{ T(ctx, "wallet.title") }</h1>
				<p><strong>{ T(ctx, "wallet.not-running") }</strong></p>
				<p class="small dim">{ T(ctx, "wallet.not-running-help") }</p>
				<p><a class="btn primary" href={ templ.URL(VisorURL(From(ctx).HVPK, "apps/catalog")) }><span class="mi">apps</span>{ T(ctx, "apps.tabs.catalog") }</a></p>
			default:
				<h1>{ T(ctx, "wallet.title") }</h1>
				<p><strong>{ T(ctx, "wallet.not-configured") }</strong></p>
				<p class="small dim">{ T(ctx, "wallet.not-configured-help") }</p>
				<p><a class="btn primary" href={ templ.URL(VisorURL(From(ctx).HVPK, "apps/catalog")) }><span class="mi">apps</span>{ T(ctx, "apps.tabs.catalog") }</a></p>
		}
		<h2>{ T(ctx, "ui2.wallet.node") }</h2>
		<iframe class="island wallet-config" src="wallet/config" title={ T(ctx, "ui2.wallet.node") }></iframe>
	}
}
