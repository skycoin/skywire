package ui2

import "strconv"

// FleetUptimePage is the uptime of every visor.
templ FleetUptimePage(f FleetUptime) {
	@Layout(T(ctx, "nodes.uptime-title"), "#/nodes/uptime") {
		<section class="card">
			<div class="head"><h1>{ T(ctx, "nodes.uptime-title") }</h1></div>
			@FleetUptimeBody(f)
		</section>
	}
}

func fleetURL(days int, all bool) string {
	u := "uptime/body?days=" + strconv.Itoa(days)
	if all {
		u += "&all=1"
	}
	return u
}

// FleetUptimeBody refreshes every minute, as the Angular page does.
templ FleetUptimeBody(f FleetUptime) {
	<div id="fleet-uptime" hx-get={ fleetURL(f.Days, f.All) } hx-trigger="every 60s [document.visibilityState === 'visible']" hx-swap="outerHTML">
		<div class="bar">
			<span class="dim">{ T(ctx, "uptime.window") }:</span>
			for _, d := range []int{1, 7, 30} {
				<button class={ "btn sm", templ.KV("primary", d == f.Days) } type="button" hx-get={ fleetURL(d, f.All) } hx-target="#fleet-uptime" hx-swap="outerHTML">
					if d == 1 {
						{ T(ctx, "uptime.window-now") }
					} else {
						{ strconv.Itoa(d) }d
					}
				</button>
			}
			<span class="dim">{ T(ctx, "uptime.fleet-filter") }:</span>
			<button class={ "btn sm", templ.KV("primary", !f.All) } type="button" hx-get={ fleetURL(f.Days, false) } hx-target="#fleet-uptime" hx-swap="outerHTML">{ T(ctx, "uptime.fleet-filter-connected") }</button>
			<button class={ "btn sm", templ.KV("primary", f.All) } type="button" hx-get={ fleetURL(f.Days, true) } hx-target="#fleet-uptime" hx-swap="outerHTML">{ T(ctx, "uptime.fleet-filter-all") }</button>
		</div>
		@ErrorBox(f.Err)
		if len(f.Rows) == 0 && f.Err == "" {
			<p class="dim">{ T(ctx, "uptime.fleet-empty") }</p>
		}
		if len(f.Rows) > 0 {
			<p class="small dim">{ itoa(len(f.Rows)) } { T(ctx, "common.visors") } · { T(ctx, "uptime.last-updated") }: { f.Fetched }</p>
			<p class="small fleet-legend">
				<span class="dim">{ T(ctx, "uptime.legend") }:</span>
				<span><span class="fb lvl0"></span>{ T(ctx, "uptime.legend-down") }</span>
				<span><span class="fb lvl1"></span>1–3</span>
				<span><span class="fb lvl2"></span>4–6</span>
				<span><span class="fb lvl3"></span>7–9</span>
				<span><span class="fb lvl4"></span>{ T(ctx, "uptime.legend-up") }</span>
				<span><span class="fb future"></span>{ T(ctx, "uptime.legend-future") }</span>
			</p>
			if vh := f.Versions; len(vh.Areas) > 0 {
				<div class="card sub">
					<div class="small"><strong>{ T(ctx, "uptime.version-history-title") }</strong> <span class="dim">({ T(ctx, "uptime.version-history-threshold") })</span></div>
					<svg class="vh-chart" viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label={ T(ctx, "uptime.version-history-title") }>
						for _, a := range vh.Areas {
							<polygon points={ a.Points } fill={ a.Color } fill-opacity="0.75" stroke={ a.Color } stroke-width="0.3"></polygon>
						}
					</svg>
					<div class="bar small dim"><span>{ vh.First }</span><span class="spacer"></span><span>{ vh.Mid }</span><span class="spacer"></span><span>{ vh.Last }</span></div>
					<div class="fleet-legend small">
						for _, a := range vh.Areas {
							<span><span class="fb" style={ "background:" + a.Color }></span>{ a.Version } ({ itoa(a.Latest) })</span>
						}
					</div>
					<p class="small dim">{ T(ctx, "uptime.version-history-latest") }: <strong>{ vh.Last }</strong> ({ T(ctx, "uptime.version-history-total") }: { itoa(vh.LatestTotal) })</p>
				</div>
			}
			<div class="fleet" data-labels>
				if len(f.Ticks) > 0 {
					<div class="fleet-row ticks small dim">
						<span></span>
						<span></span>
						<div class="fleet-bar ticks">
							for _, t := range f.Ticks {
								<span class="tick" style={ "left:" + t.Left }>{ t.Label }</span>
							}
						</div>
						<span></span>
					</div>
				}
				for _, r := range f.Rows {
					<div class={ "fleet-row", templ.KV("offline", !r.Online) }>
						<span class="mono small fleet-pk">
							<span class={ "dot", templ.KV("on", r.Online), templ.KV("off", !r.Online) }></span>
							if r.Managed {
								<a href={ templ.URL(VisorURL(r.PK, "uptime")) } title={ r.PK } data-label-for={ r.PK }>{ r.PK }</a>
							} else {
								<span title={ r.Version }>{ r.PK }</span>
							}
						</span>
						<span class={ "mono small", fleetTone(r.RecentPct) } title={ T(ctx, "uptime.today-pct") }>{ FleetPct(r.RecentPct) }</span>
						<div class="fleet-bar">
							for _, run := range r.Runs {
								<span class={ "fb", run.State } style={ "flex-grow:" + itoa(run.N) }></span>
							}
						</div>
						<span class={ "mono small", fleetTone(r.WindowPct) } title={ T(ctx, "uptime.window-avg") }>{ FleetPct(r.WindowPct) }</span>
					</div>
				}
			</div>
		}
	</div>
}
