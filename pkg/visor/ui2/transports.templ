package ui2

import (
	"context"
	"strings"
)

// TransportsPage is the transports tab: the summary and toggles, the add
// form and the list.
templ TransportsPage(t Transports) {
	@VisorLayout(t.PK, "transports") {
		<div class="head">
			<h1>{ T(ctx, "transports.title") }</h1>
		</div>
		<p class="small dim">{ T(ctx, "transports.info") }</p>
		<details class="add">
			<summary class="btn primary">{ T(ctx, "transports.create") }</summary>
			<form class="form" hx-post={ t.url("") } hx-target="#tp-body" hx-swap="outerHTML" hx-include="#tp-view">
				<label>{ T(ctx, "transports.dialog.remote-key") }<input class="mono" name="remote" required minlength="66" maxlength="66" pattern="[0-9a-fA-F]{66}"/></label>
				<label>
					{ T(ctx, "transports.dialog.transport-type") }
					<select name="type" required>
						for _, typ := range t.Types {
							<option value={ typ } selected?={ typ == "dmsg" }>{ typ }</option>
						}
					</select>
				</label>
				<label class="check" title={ T(ctx, "transports.dialog.persistent-tooltip") }><input type="checkbox" name="persistent" value="1"/>{ T(ctx, "transports.dialog.make-persistent") }</label>
				<div class="bar"><button class="btn primary" type="submit">{ T(ctx, "transports.create") }</button></div>
			</form>
		</details>
		@TransportsSummary(t, false)
		<div id="tp-panel"></div>
		<div id="tp-view" data-labels>
			<div class="bar">
				<h2>{ T(ctx, "transports.list-title") }</h2>
				@ListSearch(t.url("/body"), "#tp-body", "#tp-view", T(ctx, "ui2.list.search-transports"), t.Pager.ListQuery)
			</div>
			@TransportsBody(t)
		</div>
	}
}

// TransportsSummary is the count per type and the two switches. The list
// redraws it out of band, so one poll keeps both current.
templ TransportsSummary(t Transports, oob bool) {
	<div
		id="tp-sum"
		if oob {
			hx-swap-oob="true"
		}
	>
		@ErrorBox(t.Err)
		<dl class="kv tp-info">
			<dt>{ T(ctx, "node.details.transports-info.total") }</dt>
			<dd>
				{ itoa(t.Online()) }
				if len(t.ByType) > 0 {
					<span class="dim">({ t.TypeSummary() })</span>
				}
			</dd>
			<dt title={ T(ctx, "node.details.transports-info.autoconnect-info") }>{ T(ctx, "node.details.transports-info.autoconnect") }</dt>
			<dd>@toggle(t.url("/autoconnect"), t.Autoconnect, T(ctx, "node.details.transports-info.autoconnect-info"))</dd>
			<dt title={ T(ctx, "node.details.transports-info.is-public-info") }>{ T(ctx, "node.details.transports-info.is-public") }</dt>
			<dd>@toggle(t.url("/public"), t.Public, T(ctx, "node.details.transports-info.is-public-info"))</dd>
		</dl>
	</div>
}

// TransportsBody is the part that polls: one page of the filtered list, and
// the summary out of band.
templ TransportsBody(t Transports) {
	<div id="tp-body" hx-get={ t.url("/body") } hx-trigger="every 10s [document.visibilityState === 'visible']" hx-swap="outerHTML" hx-include="#tp-view">
		@ListState(t.Pager)
		<div class="bar">
			@PagerNav(t.Pager, t.url("/body"), "#tp-body")
			if t.Online() > 0 {
				<button class="btn warn sm" type="button" hx-delete={ t.url("") } hx-confirm={ T(ctx, "ui2.transports.remove-all-confirm") } hx-target="#tp-body" hx-swap="outerHTML">{ T(ctx, "ui2.transports.remove-all") }</button>
			}
		</div>
		if len(t.List) == 0 {
			<p class="dim">{ T(ctx, "transports.empty") }</p>
		} else if len(t.Rows) == 0 {
			<p class="dim">{ T(ctx, "ui2.list.no-match") }</p>
		} else {
			<div class="table-wrap">
				<table class="list">
					<thead>
						<tr>
							<th title={ T(ctx, "transports.persistent-tooltip") }><span class="mi">star_border</span></th>
							@SortTh(T(ctx, "transports.id"), "id", t.Pager, t.url("/body"), "#tp-body", false)
							@SortTh(T(ctx, "transports.remote-node"), "remote", t.Pager, t.url("/body"), "#tp-body", false)
							@SortTh(T(ctx, "transports.type"), "type", t.Pager, t.url("/body"), "#tp-body", false)
							@SortTh(T(ctx, "common.uploaded"), "sent", t.Pager, t.url("/body"), "#tp-body", true)
							@SortTh(T(ctx, "common.downloaded"), "recv", t.Pager, t.url("/body"), "#tp-body", true)
							@SortTh(T(ctx, "transports.latency"), "latency", t.Pager, t.url("/body"), "#tp-body", true)
							@SortTh(T(ctx, "ui2.transports.throughput"), "throughput", t.Pager, t.url("/body"), "#tp-body", true)
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, x := range t.Rows {
							@transportRow(t, x)
						}
					</tbody>
				</table>
			</div>
			if t.Pager.Pages() > 1 {
				<div class="bar">
					@PagerNav(t.Pager, t.url("/body"), "#tp-body")
				</div>
			}
		}
	</div>
}

templ toggle(url string, on bool, title string) {
	<button class={ "switch", templ.KV("on", on) } type="button" role="switch" aria-checked={ boolText(on) } title={ title } hx-put={ url } hx-vals={ onVals(!on) } hx-target="#tp-body" hx-swap="outerHTML" hx-include="#tp-view"><span></span></button>
}

templ transportRow(t Transports, x Transport) {
	<tr class={ templ.KV("offline", x.Offline) }>
		<td data-label={ T(ctx, "transports.persistent") }>
			<button
				class="icon-btn"
				type="button"
				hx-put={ t.url("/persistent") }
				hx-vals={ persistVals(x, !x.Persistent) }
				hx-confirm={ persistConfirm(ctx, x) }
				hx-target="#tp-body"
				hx-swap="outerHTML"
				title={ persistTitle(ctx, x.Persistent) }
			>
				if x.Persistent {
					<span class="mi star">star</span>
				} else {
					<span class="mi dim">star_border</span>
				}
			</button>
		</td>
		<td class="mono small" data-label={ T(ctx, "transports.id") }>
			if x.Offline {
				<span class="badge off">{ T(ctx, "transports.offline") }</span>
			} else {
				<span class="key" data-copy={ x.ID }>{ x.ID }</span>
				<span class="badge" data-label-for={ x.ID } data-label-only hidden></span>
			}
		</td>
		<td class="mono small" data-label={ T(ctx, "transports.remote-node") }><span class="key" data-copy={ x.Remote }>{ x.Remote }</span></td>
		<td data-label={ T(ctx, "transports.type") }>
			{ x.Type }
			if x.Label != "" {
				<span class="badge">{ x.Label }</span>
			}
		</td>
		<td class="num small" data-label={ T(ctx, "common.uploaded") }>{ x.Sent }</td>
		<td class="num small" data-label={ T(ctx, "common.downloaded") }>{ x.Recv }</td>
		<td class="num small" data-label={ T(ctx, "transports.latency") }>{ x.Latency }</td>
		<td class="num small" data-label={ T(ctx, "ui2.transports.throughput") }>{ x.Throughput }</td>
		<td class="actions">
			<button class="icon-btn" type="button" hx-get={ t.url("/" + x.ID + "/details") } hx-target="#tp-panel" hx-swap="innerHTML" title={ T(ctx, "transports.details.title") } aria-label={ T(ctx, "transports.details.title") }><span class="mi">info</span></button>
			if !x.Offline {
				<button class="icon-btn" type="button" data-edit-label={ x.ID } data-label-type="tp" data-prompt={ T(ctx, "edit-label.label") } title={ T(ctx, "labeled-element.edit-label") } aria-label={ T(ctx, "labeled-element.edit-label") }><span class="mi">edit</span></button>
			}
			if !x.Offline {
				<button class="icon-btn" type="button" hx-delete={ t.url("/" + x.ID) } hx-confirm={ deleteConfirm(ctx, x.Persistent) } hx-target="#tp-body" hx-swap="outerHTML" title={ T(ctx, "transports.delete") }><span class="mi">close</span></button>
			}
		</td>
	</tr>
}

func boolText(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func onVals(on bool) string {
	if on {
		return `{"on":"1"}`
	}
	return `{"on":""}`
}

func persistVals(x Transport, on bool) string {
	v := ""
	if on {
		v = "1"
	}
	return `{"pk":"` + x.Remote + `","type":"` + jsonSafe(x.Type) + `","on":"` + v + `"}`
}

func persistConfirm(ctx context.Context, x Transport) string {
	switch {
	case x.Persistent && x.Offline:
		return T(ctx, "transports.make-offline-non-persistent-confirmation")
	case x.Persistent:
		return T(ctx, "transports.make-non-persistent-confirmation")
	}
	return T(ctx, "transports.make-persistent-confirmation")
}

func persistTitle(ctx context.Context, on bool) string {
	if on {
		return T(ctx, "transports.persistent-transport-button-tooltip")
	}
	return T(ctx, "transports.non-persistent-transport-button-tooltip")
}

func deleteConfirm(ctx context.Context, persistent bool) string {
	if persistent {
		return T(ctx, "transports.delete-persistent-confirmation")
	}
	return T(ctx, "transports.delete-confirmation")
}

// jsonSafe drops the characters that would break a hand written JSON string.
func jsonSafe(s string) string {
	return strings.Map(func(r rune) rune {
		if r == '"' || r == '\\' || r < 0x20 {
			return -1
		}
		return r
	}, s)
}

// TransportDetails is one transport's details, as the Angular details
// dialog shows them.
templ TransportDetails(t Transports, x Transport) {
	<section class="card sub">
		<div class="head">
			<h2>{ T(ctx, "transports.details.title") }</h2>
			<span class="spacer"></span>
			<button class="icon-btn" type="button" data-clear="#tp-panel" aria-label={ T(ctx, "common.close") }><span class="mi">close</span></button>
		</div>
		<h3 class="small">{ T(ctx, "transports.details.basic.title") }</h3>
		<dl class="kv small" data-labels>
			<dt>{ T(ctx, "transports.details.basic.id") }</dt>
			<dd class="mono"><span class="key" data-copy={ x.ID }>{ x.ID }</span> <span class="badge" data-label-for={ x.ID } data-label-only hidden></span></dd>
			<dt>{ T(ctx, "transports.details.basic.type") }</dt>
			<dd>{ x.Type }</dd>
			<dt>{ T(ctx, "transports.details.basic.local-pk") }</dt>
			<dd class="mono"><span class="key" data-copy={ t.PK }>{ t.PK }</span></dd>
			<dt>{ T(ctx, "transports.details.basic.remote-pk") }</dt>
			<dd class="mono"><span class="key" data-copy={ x.Remote }>{ x.Remote }</span></dd>
			<dt>{ T(ctx, "transports.details.basic.persistent") }</dt>
			<dd>
				if x.Persistent {
					{ T(ctx, "common.yes") }
				} else {
					{ T(ctx, "common.no") }
				}
			</dd>
			<dt>{ T(ctx, "transports.latency") }</dt>
			<dd>{ x.Latency }</dd>
		</dl>
		<h3 class="small">{ T(ctx, "transports.details.data.title") }</h3>
		<dl class="kv small">
			<dt>{ T(ctx, "transports.details.data.uploaded") }</dt>
			<dd>{ x.Sent }</dd>
			<dt>{ T(ctx, "transports.details.data.downloaded") }</dt>
			<dd>{ x.Recv }</dd>
		</dl>
	</section>
}
